# Maintainer: Ignatius Karel <https://github.com/Aitemaa/Kadex>
pkgname=kadex
pkgver=0.1.0
pkgrel=1
pkgdesc="Ultra-lean native Rust Notepad & Sticky Notes for Wayland/Niri (wl_shm + Pango/Cairo)"
arch=('x86_64')
url="https://github.com/Aitemaa/Kadex"
license=('MIT')
depends=('wayland' 'libxkbcommon' 'pango' 'cairo' 'glib2')
makedepends=('rust' 'cargo' 'pkgconf' 'wayland')
source=()

build() {
    cd "$startdir/../.."
    export RUSTFLAGS="-C target-cpu=native -C link-arg=-Wl,--gc-sections -C link-arg=-Wl,--as-needed -C force-unwind-tables=no"
    cargo build --release --locked
}

package() {
    cd "$startdir/../.."
    install -Dm755 "target/release/kadex" "$pkgdir/usr/bin/kadex"
    install -Dm644 "packaging/kadex.desktop" "$pkgdir/usr/share/applications/kadex.desktop"
    install -Dm644 "assets/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kadex.svg"
    install -Dm644 "packaging/niri/kadex.kdl" "$pkgdir/usr/share/doc/kadex/niri-kadex.kdl"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
